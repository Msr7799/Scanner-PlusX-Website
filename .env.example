# Set this after publishing the site on your own HTTPS domain.
NEXT_PUBLIC_SITE_URL=https://scanner-plusx.vercel.app

# Google Play listing used by the download buttons.
NEXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.scannerplusx.app

# Optional website ads: use the AdSense ID and website ad slot, not Android AdMob unit IDs.
# Your site must be approved in AdSense before ads can serve.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-2259594031936212
# Use the ad unit's 10-digit slot ID here, not the AdSense customer ID.
NEXT_PUBLIC_ADSENSE_SLOT_ID=
